# Production template for source installs (deploy/linux/install.sh fills the variables through
# /etc/tokenhub/caddy.env and a systemd drop-in for caddy.service).
# Environment defaults:
# - TOKENHUB_SITE_ADDRESS=tokenhub.example.com   (or https://10.0.0.8, :80, or several comma separated)
# - TOKENHUB_CADDY_TLS=                          (e.g. "tls internal" for https://IP)
# - TOKENHUB_CADDY_GLOBAL=                       (e.g. "default_sni 10.0.0.8")
# - TOKENHUB_APP_DIR=/var/www/tokenhub
# - CADDY_ADMIN_API=off
# - TOKENHUB_PHP_FASTCGI=unix//run/php/php8.2-fpm-tokenhub.sock
#   Multiple upstreams are allowed, for example: "127.0.0.1:9000 127.0.0.1:9001"
# - TOKENHUB_TLS_FRAGMENT=/var/lib/tokenhub/caddy/tls-current.caddy
# - TOKENHUB_LOG_PATH=/var/log/tokenhub/caddy-access.log
{
	admin {$CADDY_ADMIN_API:off}
	{$TOKENHUB_CADDY_GLOBAL}
}

{$TOKENHUB_SITE_ADDRESS:localhost} {
	# Compression is applied to the static UI only: compressing API responses
	# buffers server-sent events (/v1 streaming) and delays the first token.
	{$TOKENHUB_CADDY_TLS}
	import {$TOKENHUB_TLS_FRAGMENT:/var/lib/tokenhub/caddy/tls-current.caddy}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
		-X-Powered-By
	}

	request_body {
		max_size 32MB
	}

	@blockedMethod not method GET HEAD POST PUT DELETE OPTIONS
	respond @blockedMethod 405

	@blockedPath path *.env *.git* *~ *.bak *.old *.swp /debug* /phpinfo* /server-status* /vendor/*
	respond @blockedPath 403

	@blockedQuery query token=* secret=* api_key=* apikey=* access_token=*
	respond @blockedQuery 403

	redir /admin /admin/
	redir /screen /screen/

	handle_path /admin/* {
		root * {$TOKENHUB_APP_DIR:/var/www/tokenhub}/public/admin
		encode zstd gzip
		# ES modules carry no version query: always revalidate (ETag).
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	handle_path /screen/* {
		root * {$TOKENHUB_APP_DIR:/var/www/tokenhub}/public/screen
		encode zstd gzip
		# ES modules carry no version query: always revalidate (ETag).
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	handle /admin-api/* {
		php_fastcgi {$TOKENHUB_PHP_FASTCGI:unix//run/php/php8.2-fpm-tokenhub.sock} {
			root {$TOKENHUB_APP_DIR:/var/www/tokenhub}/public
		}
	}

	handle /screen-api/* {
		php_fastcgi {$TOKENHUB_PHP_FASTCGI:unix//run/php/php8.2-fpm-tokenhub.sock} {
			root {$TOKENHUB_APP_DIR:/var/www/tokenhub}/public
		}
	}

	# Realtime speech (WebSocket) is served by the Go realtime-gateway (tokenhub-realtime.service).
	handle /v1/realtime {
		reverse_proxy {$TOKENHUB_REALTIME_UPSTREAM:127.0.0.1:8090}
	}

	handle /v1/* {
		php_fastcgi {$TOKENHUB_PHP_FASTCGI:unix//run/php/php8.2-fpm-tokenhub.sock} {
			root {$TOKENHUB_APP_DIR:/var/www/tokenhub}/public
		}
	}

	# Gemini-native API (Google GenAI SDKs).
	handle /v1beta/* {
		php_fastcgi {$TOKENHUB_PHP_FASTCGI:unix//run/php/php8.2-fpm-tokenhub.sock} {
			root {$TOKENHUB_APP_DIR:/var/www/tokenhub}/public
		}
	}

	handle /mcp {
		php_fastcgi {$TOKENHUB_PHP_FASTCGI:unix//run/php/php8.2-fpm-tokenhub.sock} {
			root {$TOKENHUB_APP_DIR:/var/www/tokenhub}/public
		}
	}

	# Built-in OAuth server for MCP clients (discovery, sign-in page, tokens).
	# The consent form is redirected to the client's callback after submission,
	# which form-action 'self' would block, so this path sets its own policy.
	@oauth path /oauth/* /.well-known/oauth-protected-resource /.well-known/oauth-protected-resource/* /.well-known/oauth-authorization-server /.well-known/oauth-authorization-server/* /.well-known/openid-configuration
	handle @oauth {
		header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; frame-ancestors 'none'; base-uri 'none'"
		php_fastcgi {$TOKENHUB_PHP_FASTCGI:unix//run/php/php8.2-fpm-tokenhub.sock} {
			root {$TOKENHUB_APP_DIR:/var/www/tokenhub}/public
		}
	}

	handle /health {
		php_fastcgi {$TOKENHUB_PHP_FASTCGI:unix//run/php/php8.2-fpm-tokenhub.sock} {
			root {$TOKENHUB_APP_DIR:/var/www/tokenhub}/public
		}
	}

	handle /ready {
		php_fastcgi {$TOKENHUB_PHP_FASTCGI:unix//run/php/php8.2-fpm-tokenhub.sock} {
			root {$TOKENHUB_APP_DIR:/var/www/tokenhub}/public
		}
	}

	handle /download/* {
		php_fastcgi {$TOKENHUB_PHP_FASTCGI:unix//run/php/php8.2-fpm-tokenhub.sock} {
			root {$TOKENHUB_APP_DIR:/var/www/tokenhub}/public
		}
	}

	handle {
		respond "Not Found" 404
	}

	log {
		output file {$TOKENHUB_LOG_PATH:/var/log/tokenhub/caddy-access.log} {
			mode 0640
			roll_size 100MiB
			roll_keep 10
			roll_keep_for 720h
		}
		format filter {
			request>headers>Authorization delete
			request>headers>Cookie delete
			request>headers>X-Api-Key delete
			request>headers>Api-Key delete
			request>headers>Set-Cookie delete
			request>uri query {
				replace token ****
				replace key ****
				replace secret ****
				replace api_key ****
				replace access_token ****
			}
			wrap json
		}
	}
}

# Internal API for the realtime gateway: loopback only, never public.
http://127.0.0.1:8082 {
	handle /internal/* {
		php_fastcgi {$TOKENHUB_PHP_FASTCGI:unix//run/php/php8.2-fpm-tokenhub.sock} {
			root {$TOKENHUB_APP_DIR:/var/www/tokenhub}/public
		}
	}
	handle {
		respond "Not Found" 404
	}
}
