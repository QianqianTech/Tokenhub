# Production template.
# Environment defaults:
# - TOKENHUB_DOMAIN=tokenhub.example.com
# - CADDY_ADMIN_API=off
# - TOKENHUB_PHP_FASTCGI=unix//run/php/php8.2-fpm-tokenhub.sock
#   Multiple upstreams are allowed, for example: "127.0.0.1:9000 127.0.0.1:9001"
# - TOKENHUB_WAF_FRAGMENT=/var/lib/tokenhub/caddy/waf-current.caddy
# - TOKENHUB_TLS_FRAGMENT=/var/lib/tokenhub/caddy/tls-current.caddy
# - TOKENHUB_LOG_PATH=/var/log/tokenhub/caddy-access.log
{
	admin {$CADDY_ADMIN_API:off}
}

{$TOKENHUB_DOMAIN:localhost} {
	encode zstd gzip
	import {$TOKENHUB_TLS_FRAGMENT:/var/lib/tokenhub/caddy/tls-current.caddy}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
		-X-Powered-By
	}

	request_body {
		max_size 32MB
	}

	@blockedMethod not method GET HEAD POST PUT DELETE OPTIONS
	respond @blockedMethod 405

	@blockedPath path *.env *.git* *~ *.bak *.old *.swp /debug* /phpinfo* /server-status* /vendor/*
	respond @blockedPath 403

	@blockedQuery query token=* secret=* api_key=* apikey=* access_token=*
	respond @blockedQuery 403

	import {$TOKENHUB_WAF_FRAGMENT:/var/lib/tokenhub/caddy/waf-current.caddy}

	redir /admin /admin/
	redir /screen /screen/

	handle_path /admin/* {
		root * /var/www/tokenhub/public/admin
		try_files {path} /index.html
		file_server
	}

	handle_path /screen/* {
		root * /var/www/tokenhub/public/screen
		try_files {path} /index.html
		file_server
	}

	handle /admin-api/* {
		php_fastcgi {$TOKENHUB_PHP_FASTCGI:unix//run/php/php8.2-fpm-tokenhub.sock} {
			root /var/www/tokenhub/public
		}
	}

	handle /screen-api/* {
		php_fastcgi {$TOKENHUB_PHP_FASTCGI:unix//run/php/php8.2-fpm-tokenhub.sock} {
			root /var/www/tokenhub/public
		}
	}

	handle /v1/* {
		php_fastcgi {$TOKENHUB_PHP_FASTCGI:unix//run/php/php8.2-fpm-tokenhub.sock} {
			root /var/www/tokenhub/public
		}
	}

	handle /health {
		php_fastcgi {$TOKENHUB_PHP_FASTCGI:unix//run/php/php8.2-fpm-tokenhub.sock} {
			root /var/www/tokenhub/public
		}
	}

	handle /ready {
		php_fastcgi {$TOKENHUB_PHP_FASTCGI:unix//run/php/php8.2-fpm-tokenhub.sock} {
			root /var/www/tokenhub/public
		}
	}

	handle /download/* {
		php_fastcgi {$TOKENHUB_PHP_FASTCGI:unix//run/php/php8.2-fpm-tokenhub.sock} {
			root /var/www/tokenhub/public
		}
	}

	handle {
		respond "Not Found" 404
	}

	log {
		output file {$TOKENHUB_LOG_PATH:/var/log/tokenhub/caddy-access.log} {
			roll_size 100MiB
			roll_keep 10
			roll_keep_for 720h
		}
		format filter {
			request>headers>Authorization delete
			request>headers>Cookie delete
			request>headers>X-Api-Key delete
			request>headers>Api-Key delete
			request>headers>Set-Cookie delete
			request>uri query {
				replace token ****
				replace key ****
				replace secret ****
				replace api_key ****
				replace access_token ****
			}
			wrap json
		}
	}
}
