# Scripts and configuration copied into Linux images must keep LF endings, also on Windows checkouts.
*.sh        text eol=lf
*.service   text eol=lf
*.conf      text eol=lf
*.ini       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
Caddyfile*  text eol=lf
Dockerfile  text eol=lf
.env.example text eol=lf
*.ps1       text eol=crlf
