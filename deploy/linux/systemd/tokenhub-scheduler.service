[Unit]
Description=TokenHub scheduler (enqueues periodic maintenance jobs)
After=network-online.target redis-server.service redis.service
Wants=network-online.target

[Service]
Type=simple
User=@APP_USER@
Group=@APP_USER@
WorkingDirectory=@APP_DIR@
ExecStart=@PHP_BIN@ @APP_DIR@/bin/scheduler.php
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/log/tokenhub /var/lib/tokenhub @APP_DIR@/storage

[Install]
WantedBy=multi-user.target
