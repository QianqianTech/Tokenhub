[Unit]
Description=TokenHub queue worker %i
After=network-online.target mysql.service mysqld.service redis-server.service redis.service
Wants=network-online.target

[Service]
Type=simple
User=@APP_USER@
Group=@APP_USER@
WorkingDirectory=@APP_DIR@
ExecStart=@PHP_BIN@ @APP_DIR@/bin/queue-worker.php
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/log/tokenhub /var/lib/tokenhub @APP_DIR@/storage

[Install]
WantedBy=multi-user.target
