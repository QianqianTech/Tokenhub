# Copy to /etc/tokenhub/tokenhub.env, replace every change-me value, then chmod 0640.
APP_ENV=production
APP_KEY=change-me-to-32-plus-random-characters
APP_URL=https://api.example.com
APP_DEBUG=false

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tokenhub
DB_USERNAME=tokenhub
DB_PASSWORD=change-me

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_DATABASE=0

QUEUE_CONNECTION=redis
QUEUE_NAME=tokenhub:jobs
QUEUE_FAILED_NAME=tokenhub:failed-jobs

SESSION_SECURE=true
ADMIN_CSRF_SECRET=change-me
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

LOG_PATH=/var/log/tokenhub
EXPORT_PATH=/var/lib/tokenhub/exports
MEDIA_PATH=/var/lib/tokenhub/media
CADDY_DATA_PATH=/var/lib/caddy
CADDY_TLS_FRAGMENT_PATH=/var/lib/tokenhub/caddy/tls-current.caddy

# Model support: media storage, vendor callbacks, realtime gateway
MEDIA_STORAGE_DRIVER=local
MEDIA_PERSIST_REMOTE=true
TASK_CALLBACKS_ENABLED=true
REALTIME_INTERNAL_TOKEN=change-me
