# Copy to /etc/tokenhub/tokenhub.env, replace every change-me value, then chmod 0640.
APP_ENV=production
APP_KEY=change-me-to-32-plus-random-characters
APP_URL=https://api.example.com
APP_DEBUG=false

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tokenhub
DB_USERNAME=tokenhub
DB_PASSWORD=change-me

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_DATABASE=0

QUEUE_CONNECTION=redis
QUEUE_NAME=tokenhub:jobs
QUEUE_FAILED_NAME=tokenhub:failed-jobs

SESSION_SECURE=true
# TokenHub APP sign-in (see .env.example for details).
APP_LINK_TTL_MINUTES=10
APP_ACCESS_TTL_MINUTES=60
APP_DEVICE_IDLE_DAYS=30
APP_HTTP_DEVICE_IDLE_DAYS=7
APP_DEVICE_MAX_DAYS=180
APP_MAX_DEVICES_PER_USER=5
APP_STEP_UP_REQUIRED=true
# Native push for the TokenHub install packages (optional, your own credentials; files readable by PHP).
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.qianqian.tokenhub
APNS_PRIVATE_KEY_PATH=
APNS_PRODUCTION=true
FCM_SERVICE_ACCOUNT_PATH=
# true: a newly linked APP device must be confirmed (match code) in the web console before it can sign in.
APP_NEW_DEVICE_APPROVAL=false
ADMIN_CSRF_SECRET=change-me
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

LOG_PATH=/var/log/tokenhub
EXPORT_PATH=/var/lib/tokenhub/exports
MEDIA_PATH=/var/lib/tokenhub/media
CADDY_DATA_PATH=/var/lib/caddy
CADDY_TLS_FRAGMENT_PATH=/var/lib/tokenhub/caddy/tls-current.caddy

# Model support: media storage, vendor callbacks, realtime gateway
MEDIA_STORAGE_DRIVER=local
MEDIA_PERSIST_REMOTE=true
TASK_CALLBACKS_ENABLED=true
REALTIME_INTERNAL_TOKEN=change-me
