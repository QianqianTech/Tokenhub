{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TokenHub",
  "version": "0.1.0",
  "identifier": "com.qianqian.tokenhub",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TokenHub",
        "width": 1280,
        "height": 820,
        "minWidth": 380,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
